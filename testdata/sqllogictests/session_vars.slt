# Tests for the Postgres-compat session variables exposed at connect time.
# Drivers (PgJDBC, asyncpg, DBeaver) read these from `ParameterStatus` and
# also via `SHOW <name>`; both code paths must agree.

query T
SHOW server_version;
----
15.1

query T
SHOW server_version_num;
----
150001

query T
SHOW server_encoding;
----
UTF8

query T
SHOW client_encoding;
----
UTF8

query T
SHOW is_superuser;
----
off

query T
SHOW session_authorization;
----
glaredb

query T
SHOW IntervalStyle;
----
postgres

query T
SHOW integer_datetimes;
----
on

query T
SHOW DateStyle;
----
ISO, MDY

query T
SHOW standard_conforming_strings;
----
on

# `SET session authorization` should be accepted (no-op enforcement; we just
# stash the value so DBeaver / JDBC can read it back).
statement ok
SET session_authorization TO 'mlucas';

query T
SHOW session_authorization;
----
mlucas

# Reset back so subsequent tests see the default.
statement ok
SET session_authorization TO 'glaredb';

# `SET IntervalStyle` should round-trip too.
statement ok
SET IntervalStyle TO 'iso_8601';

query T
SHOW IntervalStyle;
----
iso_8601

statement ok
SET IntervalStyle TO 'postgres';

# `GUC_REPORT` GUCs added in PG 14/16 — drivers (PgJDBC 42.5+,
# psycopg2 2.8+) branch on these at connect time. Real Postgres
# emits all three in the startup `ParameterStatus` chatter and
# accepts them via `SHOW`.

query T
SHOW in_hot_standby;
----
off

query T
SHOW default_transaction_read_only;
----
off

query T
SHOW scram_iterations;
----
4096

# `default_transaction_read_only` is user-configurable (matches PG's
# GUC context — `USERSET`), the other two are read-only.
statement ok
SET default_transaction_read_only TO on;

query T
SHOW default_transaction_read_only;
----
on

statement ok
SET default_transaction_read_only TO off;

# `scram_iterations` is `PGC_USERSET` in PG 16 — clients can lower it
# per session for slow handshakes. Round-trip the SET.
statement ok
SET scram_iterations TO 8192;

query T
SHOW scram_iterations;
----
8192

statement ok
SET scram_iterations TO 4096;

# `in_hot_standby` is `PGC_INTERNAL` — read-only, set must error.
statement error
SET in_hot_standby TO on;
