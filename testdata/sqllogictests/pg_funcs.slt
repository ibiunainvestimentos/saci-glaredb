# Postgres `pg_get_*` / visibility / sizing / introspection UDFs.
#
# Most of these are stubs (empty string / NULL / 0 / t) — the value isn't
# important, the *signature* is. DBeaver, ibis, dbt, JDBC etc. probe these
# functions at startup and tree-expand time and silently disable features when
# they're missing.

# pg_get_expr(adbin, adrelid [, pretty]) — identity on first arg.
query T
SELECT pg_get_expr('foo', 0::bigint);
----
foo

query T
SELECT pg_get_expr('bar baz', 0::bigint, true);
----
bar baz

# pg_get_viewdef(oid) — empty stub.
query T
SELECT pg_get_viewdef(0::bigint);
----
(empty)

query T
SELECT pg_get_viewdef(0::bigint, true);
----
(empty)

# pg_get_indexdef / pg_get_constraintdef / pg_get_triggerdef — empty stubs.
query T
SELECT pg_get_indexdef(0::bigint);
----
(empty)

query T
SELECT pg_get_indexdef(0::bigint, 0::int, true);
----
(empty)

query T
SELECT pg_get_constraintdef(0::bigint);
----
(empty)

query T
SELECT pg_get_constraintdef(0::bigint, true);
----
(empty)

query T
SELECT pg_get_triggerdef(0::bigint);
----
(empty)

query T
SELECT pg_get_functiondef(0::bigint);
----
(empty)

query T
SELECT pg_get_function_arguments(0::bigint);
----
(empty)

query T
SELECT pg_get_function_identity_arguments(0::bigint);
----
(empty)

query T
SELECT pg_get_function_result(0::bigint);
----
(empty)

# pg_get_partkeydef → NULL.
query T
SELECT pg_get_partkeydef(0::bigint) IS NULL;
----
t

# Visibility helpers — every object is reachable.
query T
SELECT pg_function_is_visible(0::bigint);
----
t

query T
SELECT pg_type_is_visible(0::bigint);
----
t

query T
SELECT pg_opclass_is_visible(0::bigint);
----
t

query T
SELECT pg_collation_is_visible(0::bigint);
----
t

query T
SELECT pg_conversion_is_visible(0::bigint);
----
t

# Sizing — everything is 0.
query I
SELECT pg_relation_size(0::bigint);
----
0

query I
SELECT pg_total_relation_size(0::bigint);
----
0

query I
SELECT pg_database_size(0::bigint);
----
0

query I
SELECT pg_table_size(0::bigint);
----
0

query I
SELECT pg_indexes_size(0::bigint);
----
0

# Comment helpers — NULL stub until COMMENT ON storage lands.
query T
SELECT obj_description(0::bigint, 'pg_class') IS NULL;
----
t

query T
SELECT col_description(0::bigint, 1::int) IS NULL;
----
t

query T
SELECT shobj_description(0::bigint, 'pg_database') IS NULL;
----
t

# has_*_privilege — always t.
query T
SELECT has_table_privilege('foo', 'SELECT');
----
t

query T
SELECT has_column_privilege('user', 'tab', 'col', 'SELECT');
----
t

# Connection metadata.
query T
SELECT pg_is_in_recovery();
----
f

query I
SELECT pg_backend_pid();
----
0

statement ok
SELECT pg_postmaster_start_time();

# pg_tablespace_location — empty.
query T
SELECT pg_tablespace_location(1663::bigint);
----
(empty)

# format_type(oid, typmod) — render the user-readable PG type name.
# Was a NULL stub before this commit; DBeaver / PgJDBC / psycopg use
# this for every column-type tooltip and `getColumns(...)` row.

# Bare scalar OIDs → human-readable aliases.
query T
SELECT format_type(16::int, NULL::int);
----
boolean

query T
SELECT format_type(20::int, NULL::int);
----
bigint

query T
SELECT format_type(23::int, NULL::int);
----
integer

query T
SELECT format_type(701::int, NULL::int);
----
double precision

query T
SELECT format_type(25::int, NULL::int);
----
text

# Unknown OID → '???' (matches real PG behaviour for missing pg_type
# rows; better than NULL since drivers test the string non-empty).
query T
SELECT format_type(99999::int, NULL::int);
----
???

# Varchar with length modifier — typmod is `length + 4`.
query T
SELECT format_type(1043::int, 14::int);
----
character varying(10)

# bpchar (CHAR) with length.
query T
SELECT format_type(1042::int, 24::int);
----
character(20)

# Timestamp with precision.
query T
SELECT format_type(1114::int, 3::int);
----
timestamp(3)

# Negative typmod = no modifier (real PG uses -1 for unspecified).
query T
SELECT format_type(1043::int, -1::int);
----
character varying

# Numeric without typmod → bare 'numeric'.
query T
SELECT format_type(1700::int, NULL::int);
----
numeric

# pg_size_pretty(bigint) — human-readable byte counts. DBeaver's
# table-size column reads this; was missing entirely before.
query T
SELECT pg_size_pretty(0::bigint);
----
0 bytes

query T
SELECT pg_size_pretty(1024::bigint);
----
1024 bytes

query T
SELECT pg_size_pretty(20480::bigint);
----
20 kB

query T
SELECT pg_size_pretty(1048576::bigint);
----
1024 kB

query T
SELECT pg_size_pretty(20971520::bigint);
----
20 MB

# to_regtype(text) — PG-spec name → OID resolver. NULL on miss.
query I
SELECT to_regtype('integer');
----
23

query I
SELECT to_regtype('int4');
----
23

query I
SELECT to_regtype('text');
----
25

query I
SELECT to_regtype('bigint');
----
20

query T
SELECT to_regtype('not-a-real-type') IS NULL;
----
t

# to_regclass / to_regproc — NULL stubs (catalog lookup deferred).
query T
SELECT to_regclass('pg_class') IS NULL;
----
t

query T
SELECT to_regproc('now') IS NULL;
----
t

# pg_my_temp_schema — always 0 (no temp namespaces).
query I
SELECT pg_my_temp_schema();
----
0

# pg_has_role — always true (open permissions model).
query T
SELECT pg_has_role('glaredb', 'USAGE');
----
t

query T
SELECT pg_has_role('user', 'role', 'USAGE');
----
t

# has_type_privilege / has_function_privilege — always true.
query T
SELECT has_type_privilege('integer', 'USAGE');
----
t

query T
SELECT has_type_privilege('user', 'integer', 'USAGE');
----
t

query T
SELECT has_function_privilege('user', 'now()', 'EXECUTE');
----
t
