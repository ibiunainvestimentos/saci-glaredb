# `pg_catalog.pg_index` — index metadata.
#
# `glare_catalog.indexes` is empty today (Delta tables have no
# secondary indexes), so the column-shape probe is what matters. The
# `int2vector`/`oidvector` columns (`indkey`, `indoption`, `indclass`)
# project as text — space-separated decimals — to round-trip through
# `_pg_expandarray` and PgJDBC's `getIndexInfo`.

# Queryable, zero rows today.
query I
SELECT COUNT(*) FROM pg_catalog.pg_index;
----
0

# Schema sanity — every PG 16 column we project is selectable.
statement ok
SELECT indexrelid, indrelid, indnatts, indnkeyatts,
       indisunique, indisprimary, indisexclusion, indimmediate,
       indisclustered, indisvalid, indcheckxmin, indisready, indislive,
       indisreplident, indkey, indcollation, indclass, indoption,
       indexprs, indpred
FROM pg_catalog.pg_index;

# Probe the column-shape via WHERE 1<>1 — the form DBeaver actually
# emits at startup.
statement ok
SELECT * FROM pg_catalog.pg_index WHERE 1 <> 1;

# `indkey` and `indoption` line up: same number of space-separated
# tokens (one per indexed column). Verify the `regexp_replace`
# rewrites every digit-run to `0` while preserving spacing.
query T
SELECT regexp_replace('1 2 3', '[0-9]+', '0', 'g');
----
0 0 0

query T
SELECT regexp_replace('1 17 42', '[0-9]+', '0', 'g');
----
0 0 0

# Empty input → empty output (no rows generated by _pg_expandarray
# downstream, which is correct for a no-key index).
query T
SELECT regexp_replace('', '[0-9]+', '0', 'g');
----
(empty)

# View-level invariant: indkey, indclass, indoption stay length-
# locked. Catches a missing `'g'` flag the moment any index row
# lands.
query I
SELECT COUNT(*) FROM pg_catalog.pg_index
WHERE indkey IS NOT NULL
  AND indclass IS NOT NULL
  AND length(indkey) <> length(indclass);
----
0
