# All medium-priority stubs are zero-row.
query II
SELECT
    (SELECT COUNT(*) FROM pg_catalog.pg_stat_user_tables) +
    (SELECT COUNT(*) FROM pg_catalog.pg_stat_user_indexes) +
    (SELECT COUNT(*) FROM pg_catalog.pg_statio_user_tables) +
    (SELECT COUNT(*) FROM pg_catalog.pg_publication_tables) +
    (SELECT COUNT(*) FROM pg_catalog.pg_partitioned_table) +
    (SELECT COUNT(*) FROM pg_catalog.pg_policy) +
    (SELECT COUNT(*) FROM pg_catalog.pg_policies) +
    (SELECT COUNT(*) FROM pg_catalog.pg_seclabel) +
    (SELECT COUNT(*) FROM pg_catalog.pg_shseclabel) +
    (SELECT COUNT(*) FROM pg_catalog.pg_init_privs) +
    (SELECT COUNT(*) FROM pg_catalog.pg_largeobject) +
    (SELECT COUNT(*) FROM pg_catalog.pg_largeobject_metadata) +
    (SELECT COUNT(*) FROM pg_catalog.pg_timezone_names) +
    (SELECT COUNT(*) FROM pg_catalog.pg_timezone_abbrevs) +
    (SELECT COUNT(*) FROM pg_catalog.pg_prepared_statements) +
    (SELECT COUNT(*) FROM pg_catalog.pg_cursors) +
    (SELECT COUNT(*) FROM pg_catalog.pg_user_mappings) +
    (SELECT COUNT(*) FROM pg_catalog.pg_rules) +
    (SELECT COUNT(*) FROM pg_catalog.pg_sequences) AS total_rows,
    19 AS expected_view_count;
