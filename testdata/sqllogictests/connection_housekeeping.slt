# Postgres connection-housekeeping commands. asyncpg / JDBC / DBeaver emit
# these on every pool release and during driver introspection. GlareDB
# accepts them as no-ops so clients don't need bespoke connection-class
# shims (see sacibackend `_GlareDBConnection.reset()` workaround for the
# prior pain point).

statement ok
RESET ALL;

statement ok
DISCARD ALL;

statement ok
DISCARD TEMP;

statement ok
DISCARD PLANS;

statement ok
DISCARD SEQUENCES;

statement ok
DEALLOCATE ALL;

statement ok
UNLISTEN *;

# Whitespace / casing variations.
statement ok
   reset all   ;

statement ok
DiScArD aLl;

# asyncpg's `Connection.reset()` sends a multi-statement combined string
# at every pool release. is_postgres_noop must split on `;` and accept
# any combination of single no-op statements + the literal advisory-
# unlock + CLOSE ALL pieces.
statement ok
SELECT pg_advisory_unlock_all();
CLOSE ALL;
UNLISTEN *;
RESET ALL;

# A proper subset of the same multi-statement form.
statement ok
UNLISTEN *;
RESET ALL;

statement ok
DISCARD PLANS;
DISCARD SEQUENCES;

# CLOSE ALL standalone (cursor housekeeping).
statement ok
CLOSE ALL;
